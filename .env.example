# Configuração local opcional. Copie para .env se quiser personalizar.
APP_PORT=8080
DB_PASSWORD=fintry-local
COOKIE_SECURE=false

# URL acessível para links de ativação e recuperação; ajuste se mudar a porta.
APP_BASE_URL=http://localhost:8080
# Docker: Mailpit local; não envia para a internet. Fora do Docker: false por padrão.
MAIL_ENABLED=true
MAIL_FROM=noreply@fintry.local
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# Opcional: proteção das credenciais de cobrança (openssl rand -base64 32).
BILLING_MASTER_KEY=

# Local: EVALUATION permite simular planos sem cobrança. Produção usa COMMERCIAL.
SAAS_MODE=EVALUATION
