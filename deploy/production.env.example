# Copie para deploy/production.env (fora do Git) e preencha os campos vazios.
# Um domínio DNS apontando para o servidor, sem protocolo, caminho ou porta.
FINTRY_DOMAIN=
ACME_EMAIL=
# Gere uma senha exclusiva com pelo menos 20 caracteres.
DB_PASSWORD=
DB_NAME=fintry
# SMTP real. 587/STARTTLS: true/false. Para 465/TLS: false/true.
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
# Use uma tag diferente por versão para manter a imagem anterior disponível.
FINTRY_IMAGE=fintry:0.20.1

# Opcional: habilita a configuração de cobranças. Gere com openssl rand -base64 32.
# Preserve em cofre separado: necessária para descriptografar as credenciais após restauração.
BILLING_MASTER_KEY=

# O Compose de produção fixa SAAS_MODE=COMMERCIAL; não habilite simulação em produção.

# Mensalidades do próprio Fintry (conta recebedora do operador, separada das empresas).
# Habilite somente após homologar Sandbox e confirmar preços/condições.
SAAS_PAYMENTS_ENABLED=false
SAAS_PAYMENTS_ENVIRONMENT=SANDBOX
SAAS_PAYMENTS_ACCOUNT=
SAAS_PAYMENTS_API_KEY=
SAAS_PAYMENTS_WEBHOOK_TOKEN=
# Valores em reais, ponto decimal, mínimo 5.00. Em branco: sem contratação integrada.
SAAS_PRICE_ESSENTIAL=
SAAS_PRICE_PRO=
SAAS_PRICE_BUSINESS=

# Rotina de geração recorrente. Ainda exige pagamentos habilitados e consentimento por empresa.
SAAS_RENEWALS_SCHEDULER_ENABLED=true
