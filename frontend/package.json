{
  "name": "fintry-workspace",
  "private": true,
  "version": "0.41.0",
  "type": "module",
  "scripts": {
    "contracts": "openapi-typescript ../api/workspace.openapi.json -o src/api/schema.d.ts",
    "contracts:check": "node scripts/check-contracts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs && node --import tsx --test src/features/dashboard/*.test.ts src/shared/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src vite.config.ts playwright.config.ts e2e",
    "format": "prettier --write src vite.config.ts playwright.config.ts e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
